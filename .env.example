# Copy to .env (local) or set as environment variables on your host.
PORT=3000
NODE_ENV=production

# Admin login (CHANGE THESE before going live)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Use-A-Strong-Password-Here
# Or, instead of ADMIN_PASSWORD, store only a bcrypt hash:
#   npm run hash-password -- "YourPassword"
# ADMIN_PASSWORD_HASH=$2a$12$....

# Long random string — keeps admins logged in across restarts
SESSION_SECRET=replace-with-64-random-characters

# ---------------- Data security ----------------
# Encryption key for student names, mobile numbers, emails and notes (AES-256-GCM).
# Generate once:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠ KEEP A SAFE COPY. If this key is lost or changed, stored data can no longer be read.
DATA_KEY=
# Main admin's mobile: login OTP (2-step sign-in) + SMS security alerts
ADMIN_NAME=Dr. Atul Kathole
ADMIN_MOBILE=9960889772
# ADMIN_2FA=false            # only to switch off the login OTP
# Optional email alerts
# ALERT_EMAIL_TO=admissions@adypu.edu.in
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SESSION_HOURS=6            # session lifetime
# IDLE_MINUTES=15            # auto sign-out after inactivity
# MSG91_ALERT_TEMPLATE_ID=   # DLT template for security-alert SMS (var: text)
# FAST2SMS_ALERT_MESSAGE_ID=

# Public address used inside QR codes (set once you have a domain; otherwise the current host is used)
# PUBLIC_URL=https://admissions.adypu.edu.in

# Shown on the form
ACADEMIC_YEAR=2027–28

# Database: leave empty to use a local SQLite file in ./data
# For cloud hosting use PostgreSQL (Render, Neon, Supabase, etc.)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ---------------- WhatsApp (Meta WhatsApp Business Cloud API) ----------------
# Students receive the OTP and confirmation on WhatsApp from your business number; SMS is used if WhatsApp fails.
# MESSAGE_CHANNEL=whatsapp        # whatsapp | sms | both
# WA_TOKEN=                       # permanent System User token
# WA_PHONE_NUMBER_ID=             # WhatsApp Manager → API setup
# WA_SENDER_MOBILE=9960889772     # the WhatsApp number itself (it cannot message itself → admin OTP/alerts go by SMS)
# WA_OTP_TEMPLATE=adypu_otp               # Authentication template with "Copy code" button
# WA_CONFIRM_TEMPLATE=adypu_enquiry_confirm # Utility template: {{1}} name, {{2}} programme, {{3}} reference no.
# WA_ALERT_TEMPLATE=              # optional Utility template {{1}} for alerts to a different admin WhatsApp number

# ---------------- Mobile OTP & SMS ----------------
# OTP verification before submitting (true/false)
OTP_REQUIRED=true
# Testing only: shows the OTP on screen instead of sending an SMS. NEVER use in production.
OTP_DEMO_MODE=false
# Send "thank you" SMS with the reference number after registration (true/false)
SEND_CONFIRMATION_SMS=true

# Provider: console (log only, for testing) | msg91 | fast2sms | twilio
SMS_PROVIDER=console

# MSG91  (https://msg91.com)
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=          # OTP template containing ##OTP##
# MSG91_CONFIRM_TEMPLATE_ID=      # Flow template with variables ##name##, ##course##, ##ref##

# Fast2SMS  (https://www.fast2sms.com)
# FAST2SMS_API_KEY=
# FAST2SMS_SENDER_ID=             # your 6-letter DLT sender ID (header)
# FAST2SMS_CONFIRM_MESSAGE_ID=    # DLT message ID of the confirmation template (3 variables)
# FAST2SMS_CONFIRM_ROUTE=dlt      # or q (Quick SMS, no DLT, higher cost)

# Twilio  (https://www.twilio.com)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1xxxxxxxxxx        # or TWILIO_MESSAGING_SERVICE_SID=

# ---------------- Chatbot ----------------
# Leave empty to use the built-in knowledge base (free). Set to let Claude answer in natural language,
# still restricted to the university facts in chat.js.
# ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-haiku-5-5
